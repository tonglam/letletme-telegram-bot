{
  "name": "letletme-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.12",
  "engines": {
    "bun": ">=1.2.12 <1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target bun --outdir dist --sourcemap"
  },
  "dependencies": {
    "elysia": "1.4.28"
  },
  "devDependencies": {
    "bun-types": "1.2.12",
    "typescript": "5.8.3"
  }
}
